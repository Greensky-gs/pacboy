#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE) cleanbuild DEFAULT_MIRROR_URL="https://git.greensky.tf/Greensky/paclibs-database" PROG_VERSION="1.0.2"

override_dh_auto_install:
	install -Dm755 bin/main.uwu debian/pacboy/usr/bin/pacboy
	install -Dm644 docs/pacboy.1 debian/pacboy/usr/share/man/man1/pacboy.1
